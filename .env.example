# Public client configuration. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name. Used only when the publishable key above is empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_.
# Required for rate limiting and for reading storage objects during download.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated OAuth providers enabled in the Supabase dashboard.
# Example: github,google
# Leave empty until the provider is configured.
NEXT_PUBLIC_AUTH_PROVIDERS=

# Upload and quota defaults. Values are bytes.
# MAX_UPLOAD_BYTES cannot exceed the database and storage bucket cap (50 MiB).
MAX_UPLOAD_BYTES=52428800
USER_STORAGE_LIMIT_BYTES=53687091200
REPOSITORY_STORAGE_LIMIT_BYTES=10737418240

# Canonical site URL used for Open Graph and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
